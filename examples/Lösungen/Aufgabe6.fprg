<?xml version="1.0" encoding="utf-8"?>
<flowgorithm fileversion="2.18">
  <attributes>
    <attribute name="name" value="Hochzaehlen"/>
  </attributes>

  <function name="Main" type="None" variable="">
    <parameters/>
    <body>

      <declare name="zahl" type="Integer" array="False"/>

      <assign variable="zahl" expression="0"/>

      <while expression="zahl < 10">

        <assign variable="zahl" expression="zahl + 1"/>

        <output expression="zahl" newline="True"/>

      </while>

    </body>
  </function>
</flowgorithm>