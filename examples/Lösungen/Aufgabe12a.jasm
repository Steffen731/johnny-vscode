; Fibonacci-Folge mit 10 Gliedern
; selbstmodifizierender JOHNNY-Code
;
; Der SAVE-Befehl verändert durch INC
; seine eigene Zieladresse:
;
; SAVE fib2
; SAVE fib3
; SAVE fib4
; ...
;
; Dadurch werden die Fibonacci-Zahlen
; automatisch in aufeinanderfolgende
; Speicherzellen geschrieben.


start:

        ; Erste Fibonacci-Zahl speichern

        TAKE one
        SAVE fib0

        ; Zweite Fibonacci-Zahl speichern

        TAKE one
        SAVE fib1

        ; Arbeitsvariablen initialisieren

        TAKE one
        SAVE a

        TAKE one
        SAVE b

        ; Noch 8 Zahlen berechnen

        TAKE eight
        SAVE counter


loop:

        ; Neue Fibonacci-Zahl berechnen

        TAKE a
        ADD b
        SAVE temp

        ; Ergebnis speichern
        ; Dieser Befehl verändert sich selbst

saveinstr:
        SAVE fib2

        ; Werte verschieben

        TAKE b
        SAVE a

        TAKE temp
        SAVE b

        ; Selbstmodifikation:
        ;
        ; SAVE fib2
        ; SAVE fib3
        ; SAVE fib4
        ; ...

        INC saveinstr

        ; Schleifenzähler verringern

        DEC counter

        ; Falls counter = 0:
        ; nächsten Befehl überspringen

        TST counter
        JMP loop

        JMP end


end:
        HLT 000


; Konstanten

one:       DAT 1
eight:     DAT 8


; Arbeitsvariablen

a:         DAT 1
b:         DAT 1

temp:      DAT 0

counter:   DAT 0


; Ausgabebereich

fib0:      DAT 0
fib1:      DAT 0
fib2:      DAT 0
fib3:      DAT 0
fib4:      DAT 0
fib5:      DAT 0
fib6:      DAT 0
fib7:      DAT 0
fib8:      DAT 0
fib9:      DAT 0